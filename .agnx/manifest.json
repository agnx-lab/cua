{
  "id": "cua",
  "name": "Cua",
  "version": "0.1.0",
  "description": "Agnx 外置：Cua（trycua/cua）—— 开源 Computer-Use 底座。本子应用只嵌它的 Web 控制台 Cua Spaces（前端 SPA，浏览器 demo 宿主），本机 8126 端口 Guest 嵌入；不接管本机真实桌面。",
  "engines": {
    "agnx": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "icon": "./.agnx/assets/icon.svg",
  "iconDark": "./.agnx/assets/icon-dark.svg",
  "platforms": {
    "desktop": "supported",
    "web": "unsupported",
    "mobile": "unsupported"
  },
  "guest": {
    "kind": "web",
    "auth": "none",
    "preferStrategy": "auto"
  },
  "sidecar": {
    "supervised": true,
    "ensureTool": ".agnx/tools/ensure-cua.mjs",
    "stateFile": "cua.json",
    "defaultPort": 8126,
    "label": "Cua Spaces Web 控制台"
  },
  "contributes": {
    "commands": [
      {
        "id": "cua.open",
        "title": "Cua"
      }
    ],
    "panels": [
      {
        "id": "cua.main",
        "title": "Cua"
      }
    ]
  },
  "permissions": {
    "system": [
      "screen.capture",
      "accessibility"
    ],
    "reason": "Cua 需要查看你的屏幕并模拟鼠标键盘，才能替你操作电脑。"
  }
}